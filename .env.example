APP_PORT=10000

# Option 1: full connection string, recommended for Railway/external Postgres.
DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: separate database variables.
DB_HOST=host
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=database

# Use only if your provider requires SSL.
DB_SSL=false
